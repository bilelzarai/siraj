# Every env file, not only `.env`: a `.env.production` or a `.env.bak` holds the
# same credentials and the bare name matched neither.
.env
.env.*
!.env.example
/bin/
/tmp/
*.log
data/

# Saved pages and scratch captures that land in the working directory.
*.html
!internal/**/*.html

# Editor and OS leavings.
.idea/
.vscode/
*.swp
.DS_Store

# Build and coverage output.
/dist/
*.out
coverage.*

# Compiled binaries built into the repository root. bin/ is the one home for
# build output; anything here is a stray that survives every checkout unnoticed.
/sirajctl
/server

# An empty directory at the root that shadows internal/i18n/locales, which is
# where the catalogues actually are. It has been deleted once; this stops it
# coming back and misfiling the next person's translation keys.
/locales/
.neon
node_modules/

# Build output: the bundler writes it, the binary embeds it.
static/dist/
