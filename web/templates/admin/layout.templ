package admin

import (
	"fmt"
	"siraj/internal/view"
)

// NavItem is one entry of the admin sidebar.
type NavItem struct {
	Label string
	Href  string
	Icon  string
	Count int
	Hot   bool
}

// NavGroup is a labelled block of the sidebar.
type NavGroup struct {
	Label string
	Items []NavItem
}

// Shell is everything the admin chrome needs: who is signed in, the counts on the
// sidebar and where the breadcrumb says we are.
type Shell struct {
	Title string
	// Section is the middle breadcrumb — People, Content, Moderation or System —
	// so the top bar says where in the console you are (A01–A11).
	Section  string
	Crumb    string
	Groups   []NavGroup
	Name     string
	Role     string
	Initials string
	Notifs   int
}

// Layout is the admin console's own document: its own stylesheet and script, its own
// theme toggle (the console does not follow the player's theme).
templ Layout(v *view.Ctx, s Shell) {
	<!DOCTYPE html>
	<html lang={ v.Lang } dir={ v.Dir } class="no-js">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ v.CSRF }/>
		<meta name="error-message" content={ v.Tr("error.something_went_wrong") }/>
			<title>{ s.Title } · { v.Tr("admin.console") }</title>
			<link rel="icon" href="/static/lamp.svg" type="image/svg+xml"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@500&amp;family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&amp;family=Noto+Naskh+Arabic:wght@400;600;700&amp;display=swap"
				rel="stylesheet"
			/>
			for _, href := range v.Assets.AdminCSS() {
				<link rel="stylesheet" href={ href }/>
			}
			<script>
				document.documentElement.classList.remove("no-js");
				try {
					var t = localStorage.getItem("siraj-admin-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
					document.documentElement.setAttribute("data-theme", t);
				} catch (e) {}
			</script>
			if v.Assets.Dev() {
				<script type="module" src={ v.Assets.ViteClient() }></script>
			}
			<script type="module" src={ v.Assets.AdminJS() } defer></script>
		</head>
		<body data-page={ s.Crumb }>
			@Sprite()
			<div class="app">
				@sidebar(v, s)
				<div class="main">
					@topbar(v, s)
					<main class="page" id="main">
						{ children... }
					</main>
				</div>
			</div>
			// Drawers arrive here from the server, one at a time (A02b, A04b…).
			<div id="drawer-slot"></div>
			<div class="scrim" data-scrim></div>
				<div class="toasts" aria-live="polite"></div>
</body>
	</html>
}

templ sidebar(v *view.Ctx, s Shell) {
	<aside class="sidebar" aria-label={ v.Tr("admin.nav") }>
		<a class="brand" href="/admin">
			<span class="brand-mark">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="19.6" cy="6.4" r="4.2" fill="#ffd885" opacity=".22"></circle>
					<path d="M19.7 2.4c1.5 1.8 1.9 3.2 1.3 4.5-.4.8-1.2 1.1-1.9.8-.9-.4-1-1.5-.3-2.6.5-.7.8-1.5.9-2.7z" fill="#ffd885"></path>
					<path d="M2 12.6h13.1c1.5 0 2.5-.5 3.4-1.4l1.9-1.8c.3-.3.8 0 .6.4-.9 2.4-2.9 6.1-8.3 6.1H7.6c-2.9 0-4.9-1.3-5.6-3.3z" fill="#e8b65a"></path>
					<path d="M8.6 15.9 7.5 19.6h7.2l-1.1-3.7z" fill="#c48f2f"></path>
					<path d="M6.5 20.4h9.2" stroke="#e8b65a" stroke-width="1.5" stroke-linecap="round"></path>
				</svg>
			</span>
			<span>
				<span class="brand-name">{ v.Tr("app.name") }</span>
				<span class="brand-sub">{ v.Tr("admin.console") }</span>
			</span>
		</a>
		<nav class="nav">
			for _, g := range s.Groups {
				<div class="nav-group">
					<div class="nav-label">{ g.Label }</div>
					for _, it := range g.Items {
						<a
							class={ "nav-item", templ.KV("is-active", v.Path == it.Href) }
							href={ templ.URL(it.Href) }
							if v.Path == it.Href {
								aria-current="page"
							}
						>
							@icon(it.Icon, "")
							<span>{ it.Label }</span>
							if it.Count > 0 {
								<span class={ "nav-count", templ.KV("is-hot", it.Hot) }>{ fmt.Sprint(it.Count) }</span>
							}
						</a>
					}
				</div>
			}
		</nav>
		<div class="side-foot">
			<span class="avatar" style="--c:var(--brand)">{ s.Initials }</span>
			<span class="who">
				<b>{ s.Name }</b>
				<span>{ s.Role }</span>
			</span>
			<form method="post" action="/signout">
				<input type="hidden" name="csrf_token" value={ v.CSRF }/>
				<button class="icon-btn sm" type="submit" aria-label={ v.Tr("action.signout") }>
					@icon("logout", "icon-sm")
				</button>
			</form>
		</div>
	</aside>
}

templ topbar(v *view.Ctx, s Shell) {
	<header class="topbar">
		<button class="icon-btn menu-btn" data-nav-toggle aria-label={ v.Tr("admin.nav") }>
			@icon("menu", "")
		</button>
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/admin">{ v.Tr("admin.title") }</a>
			@icon("chevron-right", "icon-flip")
			if s.Section != "" {
				<span>{ s.Section }</span>
				@icon("chevron-right", "icon-flip")
			}
			<b>{ s.Title }</b>
		</nav>
		<form class="top-search" method="get" action="/admin/search">
			<span class="sr-only">{ v.Tr("admin.search") }</span>
			@icon("search", "icon-sm")
			<input type="search" name="q" placeholder={ v.Tr("admin.search_placeholder") }/>
			<span class="kbd">Ctrl K</span>
		</form>
		<div class="top-actions">
			<a class="btn btn-ghost btn-sm open-app" href="/">
				@icon("external", "icon-sm")
				{ v.Tr("admin.open_app") }
			</a>
			<button class="icon-btn" data-theme-toggle aria-label={ v.Tr("theme.label") }>
				@icon("moon", "")
			</button>
			<a class={ "icon-btn", templ.KV("dot-badge", s.Notifs > 0) } href="/notifications" aria-label={ v.Tr("notifications.title") }>
				@icon("bell", "")
			</a>
		</div>
	</header>
}

// icon renders one symbol of the admin sprite.
templ icon(name string, class string) {
	<svg class={ "icon", class } aria-hidden="true"><use href={ templ.SafeURL("#i-" + name) }></use></svg>
}

// Icon is the exported form, for the screens.
templ Icon(name string) {
	@icon(name, "")
}

// IconClass is Icon with an extra class (icon-sm, icon-lg, icon-flip).
templ IconClass(name string, class string) {
	@icon(name, class)
}

// AppIcon draws a domain or category icon from the player sprite, which is where the
// catalog's icon names live (the admin sprite only holds the console's own icons).
templ AppIcon(name string) {
	<svg class="icon" aria-hidden="true"><use href={ templ.SafeURL("/static/icons.svg#i-" + name) }></use></svg>
}
