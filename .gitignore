# Every env file, not only `.env`: a `.env.production` or a `.env.bak` holds the
# same credentials and the bare name matched neither.
.env
.env.*
!.env.example
/bin/
/tmp/
*.log
data/

# Saved pages and scratch captures that land in the working directory.
*.html
!internal/**/*.html

# Editor and OS leavings.
.idea/
.vscode/
*.swp
.DS_Store

# Build and coverage output.
/dist/
*.out
coverage.*

# Compiled binaries built into the repository root.
/sirajctl
/server
.neon
node_modules/
