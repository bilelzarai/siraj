package views

// AuthForm carries submitted values back so a failed post does not wipe the
// form, plus the per-field error keys resolved to text.
type AuthForm struct {
	Identifier  string
	Username    string
	Email       string
	DisplayName string
	Errors      map[string]string
	General     string
}

func (f AuthForm) Err(field string) string {
	if f.Errors == nil {
		return ""
	}
	return f.Errors[field]
}

// Problems lists the failing fields for the summary banner. Order follows the
// form so the list reads top to bottom.
func (f AuthForm) Problems(c Ctx, fields [][2]string) []FieldProblem {
	var out []FieldProblem
	for _, pair := range fields {
		if msg := f.Err(pair[0]); msg != "" {
			out = append(out, FieldProblem{ID: pair[0], Label: c.T(pair[1]), Message: msg})
		}
	}
	return out
}

templ Login(c Ctx, form AuthForm) {
	@Base(c, c.T("auth.login.title")) {
		<div class="shell shell--narrow">
			<div class="card card--pad-lg stack">
				<div>
					<h1>{ c.T("auth.login.title") }</h1>
					<p class="muted small">{ c.T("auth.login.subtitle") }</p>
				</div>
				@FormProblems(c, form.General, form.Problems(c, [][2]string{
					{"identifier", "auth.field.identifier"},
					{"password", "auth.field.password"},
				}))
				<form method="post" action="/login" class="stack" novalidate>
					<input type="hidden" name="csrf_token" value={ c.CSRF }/>
					@TextField(c, TextFieldOpts{
						ID:           "identifier",
						Name:         "identifier",
						Label:        c.T("auth.field.identifier"),
						Value:        form.Identifier,
						Autocomplete: "username",
						Required:     true,
						Error:        form.Err("identifier"),
					})
					@PasswordField(c, PasswordFieldOpts{
						ID:           "password",
						Name:         "password",
						Label:        c.T("auth.field.password"),
						Autocomplete: "current-password",
						Required:     true,
						Error:        form.Err("password"),
					})
					<div class="row" style="justify-content:flex-end">
						<a class="tiny" href="/forgot" style="color:var(--accent)">
							{ c.T("auth.forgot.link") }
						</a>
					</div>
					<button class="btn btn--primary btn--block btn--lg" type="submit">
						{ c.T("auth.submit.login") }
					</button>
				</form>
				<p class="center small muted">
					{ c.T("auth.switch.toRegister") }
					<a href="/register" class="bold accent">
						{ c.T("nav.register") }
					</a>
				</p>
			</div>
		</div>
	}
}

templ Register(c Ctx, form AuthForm) {
	@Base(c, c.T("auth.register.title")) {
		<div class="shell shell--narrow">
			<div class="card card--pad-lg stack">
				<div>
					<h1>{ c.T("auth.register.title") }</h1>
					<p class="muted small">{ c.T("auth.register.subtitle") }</p>
				</div>
				@FormProblems(c, form.General, form.Problems(c, [][2]string{
					{"display_name", "auth.field.displayName"},
					{"username", "auth.field.username"},
					{"email", "auth.field.email"},
					{"password", "auth.field.password"},
					{"password_confirm", "auth.field.passwordConfirm"},
				}))
				<form method="post" action="/register" class="stack" novalidate>
					<input type="hidden" name="csrf_token" value={ c.CSRF }/>
					@TextField(c, TextFieldOpts{
						ID:           "display_name",
						Name:         "display_name",
						Label:        c.T("auth.field.displayName"),
						Value:        form.DisplayName,
						Autocomplete: "name",
						Required:     true,
						Error:        form.Err("display_name"),
					})
					@TextField(c, TextFieldOpts{
						ID:           "username",
						Name:         "username",
						Label:        c.T("auth.field.username"),
						Value:        form.Username,
						Autocomplete: "username",
						Dir:          "ltr",
						Required:     true,
						Error:        form.Err("username"),
					})
					@TextField(c, TextFieldOpts{
						ID:           "email",
						Name:         "email",
						Label:        c.T("auth.field.email"),
						Value:        form.Email,
						Type:         "email",
						Autocomplete: "email",
						Dir:          "ltr",
						Required:     true,
						Error:        form.Err("email"),
					})
					@PasswordField(c, PasswordFieldOpts{
						ID:           "password",
						Name:         "password",
						Label:        c.T("auth.field.password"),
						Autocomplete: "new-password",
						Required:     true,
						MinLength:    8,
						Error:        form.Err("password"),
						Hint:         c.T("auth.passwordHint"),
					})
					@PasswordField(c, PasswordFieldOpts{
						ID:           "password_confirm",
						Name:         "password_confirm",
						Label:        c.T("auth.field.passwordConfirm"),
						Autocomplete: "new-password",
						Required:     true,
						Error:        form.Err("password_confirm"),
					})
					<button class="btn btn--primary btn--block btn--lg" type="submit">
						{ c.T("auth.submit.register") }
					</button>
				</form>
				<p class="center small muted">
					{ c.T("auth.switch.toLogin") }
					<a href="/login" class="bold accent">
						{ c.T("nav.login") }
					</a>
				</p>
			</div>
		</div>
	}
}
