# Copy to .env and adjust. Every variable the server reads is listed here.

APP_ENV=development
APP_ADDR=:8080

DATABASE_URL=postgres://siraj:siraj@localhost:5434/siraj-db?sslmode=disable

# Required in production. Generate with: openssl rand -hex 32
# Signs the flash cookie, so rotating it invalidates any in-flight banner.
SESSION_SECRET=
SESSION_LIFETIME=720h

# Set true when serving over HTTPS. Production refuses to start without it:
# a session cookie without Secure travels in clear over any plain-HTTP hop.
SECURE_COOKIES=false

# The absolute origin players reach, used in password-reset links. Derived from
# APP_ADDR in development; required, and must be https://, in production.
# BASE_URL=https://siraj.example

# How many reverse proxies sit in front of this process. 0 — the default — means
# the peer address comes from the connection and X-Forwarded-For is ignored,
# because a header anyone can set must not decide who the login and
# password-reset limiters are throttling. Set 1 behind a single proxy, 2 for a
# CDN in front of that, and so on.
TRUSTED_PROXY_HOPS=0

# ar | en | fr
DEFAULT_LOCALE=ar

# Upsert the bundled question bank on boot. Off, and meant to stay off: load the
# bank once with `sirajctl seed` instead, so content arrives when somebody asks
# for it rather than on every restart. Either way, translations that something
# else has edited since — an import, an approved machine translation, the admin
# editor — are left alone.
SEED_ON_START=false

# Serve CSS/JS from disk instead of the embedded copy (development only).
# STATIC_DIR=./static

# ---- outbound mail ---------------------------------------------------------
# With no SMTP_HOST the mailer logs the message instead of sending it, so the
# password-reset flow works end to end with nothing configured.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=siraj@example.test
# SMTP_FROM_NAME=Sirāj
# SMTP_STARTTLS=true

# ---- machine translation ---------------------------------------------------
# none (default) | claude | libretranslate
#
# Output is written with needs_review set and every player-facing query filters
# on that, so nothing machine-written reaches a player before a human approves
# it in /admin/review. With no provider, /admin/review offers the question
# editor and bulk import instead.
TRANSLATE_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# LIBRETRANSLATE_URL=
# LIBRETRANSLATE_API_KEY=

# Where sent photos, voice notes and files are written. Empty turns uploads off.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=8
# How many files one message may carry. The ceiling on a request body is
# derived from this and MAX_UPLOAD_MB together.
MAX_FILES_PER_MESSAGE=5
