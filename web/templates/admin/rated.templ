package admin

import (
	"fmt"
	"siraj/internal/view"
)

// A09. The table said a question scored 2.1 out of five; it did not say that a
// quarter of the people who played it thought it was wrong, nor what they thought was
// wrong with it. This screen leads with that: how the ratings split, and the reasons
// players picked, so a moderator can see what to fix before opening anything.

// RatedPerPage is how many rows one page carries.
const RatedPerPage = 25

// RatedRow is one question to fix.
type RatedRow struct {
	ID          int64
	Body        string
	Category    string
	Color       string
	Icon        string
	Ratings     int
	Up          int
	Down        int
	DownPercent int
	// Reasons are what players picked, most-picked first, already translated.
	Reasons []RatedReason
}

// RatedReason is one chip under a row.
type RatedReason struct {
	Label string
	Count int
}

// UpPercent is the share that liked it; kept beside DownPercent so the bar and the
// numbers under it can never disagree.
func (r RatedRow) UpPercent() int { return 100 - r.DownPercent }

// RatedData backs A09.
type RatedData struct {
	Rows []RatedRow
	// The three cards.
	PositivePercent int
	Ratings         int
	BelowThreshold  int
	TopReason       string
	TopReasonCount  int
	ReasonsGiven    int
	// The toolbar.
	Days    int
	Reason  string
	Reasons []RatedReason
	Page    int
	Pages   int
	Total   int
	From    int
	To      int
}

templ Rated(v *view.Ctx, s Shell, d RatedData) {
	@Layout(v, s) {
		<div class="page-head">
			<div>
				<h1>{ v.Tr("admin.rated") }</h1>
				<p class="sub">{ v.Tr("admin.rated_sub") }</p>
			</div>
			<div class="actions">
				<select class="select" aria-label={ v.Tr("admin.range") } onchange="location.href=this.value">
					for _, r := range []struct {
						Days  int
						Label string
					}{{7, v.Tr("admin.range_7d")}, {30, v.Tr("admin.range_30d")}, {90, v.Tr("admin.range_90d")}} {
						<option value={ ratedHref(d, "days", fmt.Sprint(r.Days)) } selected?={ d.Days == r.Days }>
							{ r.Label }
						</option>
					}
				</select>
			</div>
		</div>
		<div class="kpis">
			<div class="kpi">
				<div class="kpi-label">
					@IconClass("thumbs-up", "icon-sm")
					{ v.Tr("admin.positive_overall") }
				</div>
				<div class="kpi-value">{ fmt.Sprintf("%d%%", d.PositivePercent) }</div>
				<div class="kpi-foot">{ v.Tr("admin.ratings_in_range", "n", d.Ratings, "days", d.Days) }</div>
			</div>
			<div class="kpi kpi-warn">
				<div class="kpi-label">
					@IconClass("thumbs-down", "icon-sm")
					{ v.Tr("admin.below_threshold") }
				</div>
				<div class="kpi-value">{ fmt.Sprint(d.BelowThreshold) }</div>
				<div class="kpi-foot">{ v.Tr("admin.over_quarter_negative") }</div>
			</div>
			<div class="kpi">
				<div class="kpi-label">
					@IconClass("flag", "icon-sm")
					{ v.Tr("admin.most_picked_reason") }
				</div>
				<div class="kpi-value kpi-text">
					if d.TopReason != "" {
						{ reasonLabel(v, d.TopReason) }
					} else {
						{ v.Tr("admin.no_reasons_yet") }
					}
				</div>
				if d.TopReason != "" {
					<div class="kpi-foot">{ v.Tr("admin.n_of_reasons", "n", d.TopReasonCount, "total", d.ReasonsGiven) }</div>
				}
			</div>
		</div>
		<section class="panel">
			<div class="panel-head">
				<div>
					<h2>{ v.Tr("admin.questions_to_fix") }</h2>
					<p class="hint">{ v.Tr("admin.sorted_by_negative") }</p>
				</div>
				if len(d.Reasons) > 0 {
					<div class="segmented" role="group" aria-label={ v.Tr("admin.reason") }>
						<a href={ templ.URL(ratedHref(d, "reason", "")) } aria-pressed={ fmt.Sprint(d.Reason == "") }>
							{ v.Tr("admin.all") }
						</a>
						for _, r := range d.Reasons {
							<a
								href={ templ.URL(ratedHref(d, "reason", r.Label)) }
								aria-pressed={ fmt.Sprint(d.Reason == r.Label) }
							>{ reasonLabel(v, r.Label) }</a>
						}
					</div>
				}
			</div>
			if len(d.Rows) == 0 {
				<div class="panel-body">
					<div class="empty"><p>{ v.Tr("admin.no_rated") }</p></div>
				</div>
			} else {
				for _, r := range d.Rows {
					@ratedRow(v, r)
				}
			}
			<div class="panel-foot">
				<span class="result-meta">{ v.Tr("admin.showing", "from", d.From, "to", d.To, "total", d.Total) }</span>
				if d.Pages > 1 {
					<nav class="pagination" aria-label={ v.Tr("admin.pages") }>
						for i := 1; i <= d.Pages; i++ {
							<a
								class="page-n"
								href={ templ.URL(ratedHref(d, "page", fmt.Sprint(i))) }
								aria-current={ ariaPage(i == d.Page) }
							>{ fmt.Sprint(i) }</a>
						}
					</nav>
				}
			</div>
		</section>
	}
}

templ ratedRow(v *view.Ctx, r RatedRow) {
	<div class="rating-row">
		<div class="cell-main min0">
			<span class="cat-tile" style={ "--c:" + first(r.Color, "var(--brand)") } aria-hidden="true">
				@AppIcon(first(r.Icon, "question"))
			</span>
			<div class="min0">
				<a class="t" href={ templ.URL(fmt.Sprintf("/admin/questions/%d", r.ID)) } dir="auto">{ r.Body }</a>
				<div class="s">
					{ fmt.Sprintf("#%d · ", r.ID) }
					{ r.Category }
					{ fmt.Sprintf(" · %d", r.Ratings) }
					{ " " }
					{ v.Tr("admin.ratings_word") }
				</div>
			</div>
		</div>
		<div>
			<div class="rating-split" role="img" aria-label={ v.Tr("admin.split_label", "up", r.UpPercent(), "down", r.DownPercent) }>
				<i class="up" style={ fmt.Sprintf("--up:%d%%", r.UpPercent()) }></i>
				<i class="down" style={ fmt.Sprintf("--down:%d%%", r.DownPercent) }></i>
			</div>
			<div class="rating-nums">
				<span>
					@IconClass("thumbs-up", "icon-sm")
					{ fmt.Sprintf("%d%%", r.UpPercent()) }
				</span>
				<span>
					{ fmt.Sprintf("%d%%", r.DownPercent) }
					@IconClass("thumbs-down", "icon-sm")
				</span>
			</div>
		</div>
		<div class="reasons">
			for _, reason := range r.Reasons {
				<span class="badge badge-neutral no-dot">
					{ reasonLabel(v, reason.Label) }
					{ " " }
					<b>{ fmt.Sprint(reason.Count) }</b>
				</span>
			}
		</div>
		<div class="cell-actions">
			<a class="btn btn-sm btn-soft" href={ templ.URL(fmt.Sprintf("/admin/questions/%d", r.ID)) }>
				@IconClass("edit", "icon-sm")
				{ v.Tr("admin.fix") }
			</a>
			<form method="post" action="/admin/questions/bulk">
				<input type="hidden" name="csrf_token" value={ v.CSRF }/>
				<input type="hidden" name="ids" value={ fmt.Sprint(r.ID) }/>
				<input type="hidden" name="action" value="review"/>
				<button class="btn btn-sm" type="submit">
					@IconClass("review", "icon-sm")
					{ v.Tr("admin.send_to_review") }
				</button>
			</form>
		</div>
	</div>
}
