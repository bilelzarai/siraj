# Copy this file to .env (the server reads it on start; real environment variables win).
APP_ENV=development
HTTP_ADDR=:8080
POSTGRES_PORT=5442
DATABASE_URL=postgres://siraj:secret@localhost:5442/siraj?sslmode=disable
SESSION_TTL_HOURS=720
GUEST_TTL_HOURS=24

# Uploads (D-02): local disk in dev, s3 (Cloudflare R2) in production
STORAGE_DRIVER=local
UPLOADS_DIR=./var/uploads

# Assets: dev reads web/assets through Vite on :5173, production reads web/dist
# VITE_DEV_SERVER=http://localhost:5173   # set by `make dev`; empty = serve the built assets in web/dist

# Mail: empty SMTP_ADDR writes the mail to the log instead of sending it. In
# production that silently breaks signing in — the six-digit code is how a player gets
# in, and a code in the server log never reaches them. Set it before you deploy.
SMTP_ADDR=
MAIL_FROM=Siraj <no-reply@siraj.app>

# Phone sign-in. No gateway is implemented yet (internal/platform/sms): with this
# empty the code is written to the log, and in production nothing shows it on screen
# either, so the phone tab cannot let anyone in. Until a Sender is written, deploy
# with the address tab as the way in.
SMS_PROVIDER=

# Who may call /api/v1 from a browser on another host (comma-separated origins).
# A mobile app does not need this; empty answers no cross-origin call. "*" = any (dev only).
CORS_ORIGINS=

# Sign in with Google and with Apple (endpoint 3). Empty hides that button.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
BASE_URL=http://localhost:8080
