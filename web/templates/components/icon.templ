package components

import "siraj/internal/view"

// Icon draws one icon from the sprite (web/public/icons.svg, generated from the design kit).
// Stroke icons on a 24 px grid; never paste a path into a template.
templ Icon(name string) {
	<svg class="i" aria-hidden="true"><use href={ templ.URL("/static/icons.svg#i-" + name) }></use></svg>
}

// IconClass adds a size or a modifier class ("i-sm", "i-lg", "flip" for RTL arrows).
templ IconClass(name string, class string) {
	<svg class={ "i", class } aria-hidden="true"><use href={ templ.URL("/static/icons.svg#i-" + name) }></use></svg>
}

// Lamp is the logo: the lamp of Sirāj (BR-05).
templ Lamp() {
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="19.6" cy="6.4" r="4.2" fill="#ffd885" opacity=".22"></circle>
		<path d="M19.7 2.4c1.5 1.8 1.9 3.2 1.3 4.5-.4.8-1.2 1.1-1.9.8-.9-.4-1-1.5-.3-2.6.5-.7.8-1.5.9-2.7z" fill="#ffd885"></path>
		<path d="M2 12.6h13.1c1.5 0 2.5-.5 3.4-1.4l1.9-1.8c.3-.3.8 0 .6.4-.9 2.4-2.9 6.1-8.3 6.1H7.6c-2.9 0-4.9-1.3-5.6-3.3z" fill="#e8b65a"></path>
		<path d="M8.6 15.9 7.5 19.6h7.2l-1.1-3.7z" fill="#c48f2f"></path>
		<path d="M6.5 20.4h9.2" stroke="#e8b65a" stroke-width="1.5" stroke-linecap="round"></path>
	</svg>
}

// Pattern is the Islamic geometric background. CSS hides it outside the Islamic
// family (BR-03): .pattern is only displayed under [data-family="islamic"] / .fam-islamic.
templ Pattern(id string) {
	<svg class="pattern" aria-hidden="true">
		<defs>
			<pattern id={ id } width="64" height="64" patternUnits="userSpaceOnUse">
				<rect x="14" y="14" width="36" height="36" fill="none" stroke="#e8d3a2" stroke-width="1.2"></rect>
				<rect x="14" y="14" width="36" height="36" fill="none" stroke="#e8d3a2" stroke-width="1.2" transform="rotate(45 32 32)"></rect>
				<circle cx="32" cy="32" r="5" fill="none" stroke="#e8d3a2" stroke-width="1.2"></circle>
			</pattern>
		</defs>
		<rect width="100%" height="100%" fill={ "url(#" + id + ")" }></rect>
	</svg>
}

// Motif is the large background icon of a general domain (BR-03).
templ Motif(name string) {
	<span class="motif" aria-hidden="true">
		@Icon(name)
	</span>
}

// DomainChip names the domain a question or a card belongs to, in the domain's colour.
templ DomainChip(d view.Domain) {
	@DomainChipOf(d.Name, d.Icon, d.Color)
}

// DomainChipOf is the same chip for screens that only carry the three fields.
templ DomainChipOf(name string, icon string, color string) {
	<span class="dom-chip" style={ "--c:" + color }>
		@Icon(icon)
		{ name }
	</span>
}
