package views

import "github.com/bilelzarai/siraj/internal/models"

// Starting a challenge from a list.
//
// There was a dialog here — three tabs, a search, paging, multi-select — built
// when every Challenge button was a link to a setup screen that could not do
// any of that. The screen can now: it picks a group, searches within it, and
// arranges sides. So the dialog had become a second, smaller copy of it,
// reachable by a different press, and the two would have drifted.
//
// One destination from every list.

// ChallengeButton is how a challenge starts from a list.
//
// A link to the screen that sets a round up, carrying who it is about and
// which group they were listed under — so a room member arrives with the room
// tab open and their name already ticked, and somebody who is both a friend
// and in your room is challenged as whichever list you pressed. One
// destination from every list, rather than a dialog from some and a page from
// others.
templ ChallengeButton(c Ctx, u *models.UserCard, class, source string) {
	<a
		class={ class }
		href={ templ.SafeURL("/challenges/new?opponent=" + u.Username + "&group=" + source) }
	>
		{ c.T("friends.challenge") }
	</a>
}
