package views

import (
	"fmt"
	"net/url"

	"github.com/bilelzarai/siraj/internal/models"
)

// ------------------------------------------------------------ player side --

type SupportData struct {
	Tickets []*models.Ticket
}

templ Support(c Ctx, d SupportData) {
	@Base(c, c.T("support.title")) {
		<div class="shell shell--narrow stack" data-live="support.reply">
			@BackLink(c, "/app", c.T("nav.home"))
			@PageHead(c.T("support.title"), c.T("support.subtitle")) {
				<a class="btn btn--primary btn--sm" href="/support/new">
					<span aria-hidden="true">✚</span> { c.T("support.new") }
				</a>
			}
			if len(d.Tickets) == 0 {
				@EmptyWithAction("💬", c.T("support.empty"), "/support/new", c.T("support.new"))
			} else {
				<div class="card card--flush">
					for _, t := range d.Tickets {
						<a class="ticket-row" href={ templ.SafeURL("/support/" + t.ID.String()) }>
							<span class="ticket-row__icon" aria-hidden="true">{ ticketIcon(t.Kind) }</span>
							<div style="flex:1;min-width:0">
								<div class="row gap-4">
									<span class="bold small truncate">{ t.Subject }</span>
									if t.UserUnread > 0 {
										<span class="count-dot" aria-label={ c.T("messages.unread", t.UserUnread) }>{ fmt.Sprint(t.UserUnread) }</span>
									}
								</div>
								<div class="tiny muted">
									{ c.T(models.TicketKindKey(t.Kind)) } · { c.Tr.RelativeTime(t.LastMessageAt) }
								</div>
							</div>
							if t.NeedsYou() {
								<span class="tag tag--warning">{ c.T("support.stage.yourturn") }</span>
							} else {
								<span class={ "tag", statusTagClass(t.Status) }>
									{ c.T(t.StageKey()) }
								</span>
							}
						</a>
					}
				</div>
			}
		</div>
	}
}

type SupportNewData struct {
	Kind       string
	Subject    string
	Body       string
	CategoryID int
	QuestionID int
	PagePath   string
	Categories []*models.Category
	// Reported is the player a report of abuse is about, as typed. Echoed back
	// so a rejected form does not make somebody find the name again.
	Reported string
	// People the sender can name: friends and the people in their room. A
	// report is about somebody you have actually met here.
	Known  []*models.UserCard
	Error  string
	Errors map[string]string
}

func (d SupportNewData) Err(field string) string {
	if d.Errors == nil {
		return ""
	}
	return d.Errors[field]
}

func (d SupportNewData) Problems(c Ctx) []FieldProblem {
	var out []FieldProblem
	for _, pair := range [][2]string{
		{"kind", "support.field.kind"},
		{"subject", "support.field.subject"},
		{"body", "support.field.body"},
	} {
		if msg := d.Err(pair[0]); msg != "" {
			out = append(out, FieldProblem{ID: pair[0], Label: c.T(pair[1]), Message: msg})
		}
	}
	return out
}

templ SupportNew(c Ctx, d SupportNewData) {
	@Base(c, c.T("support.new")) {
		<div class="shell shell--narrow stack">
			@BackLink(c, "/support", c.T("support.title"))
			<h1 style="font-size:1.4rem">{ c.T("support.new") }</h1>
			@FormProblems(c, d.Error, d.Problems(c))
			<form method="post" action="/support/new" class="card card--pad-lg stack" novalidate>
				<input type="hidden" name="csrf_token" value={ c.CSRF }/>
				<input type="hidden" name="page_path" value={ d.PagePath }/>
				if d.QuestionID > 0 {
					<input type="hidden" name="question" value={ fmt.Sprint(d.QuestionID) }/>
				}
				<div class="field" id="kind" data-ticket-kind x-data="ticketKind" x-on:change="choose">
					<span class="label">{ c.T("support.field.kind") }</span>
					// Choosing the kind up front is what makes the staff queue
					// triageable, so it is asked first and is required.
					<div class="choice-grid">
						for _, kind := range models.TicketKinds {
							<label class="chip-radio">
								<input type="radio" name="kind" value={ kind } checked?={ d.Kind == kind } required/>
								<span class="chip-radio__face">
									<span aria-hidden="true">{ ticketIcon(kind) }</span>
									<span class="truncate">{ c.T(models.TicketKindKey(kind)) }</span>
								</span>
							</label>
						}
					</div>
					if e := d.Err("kind"); e != "" {
						@FieldError("kind", e)
					}
					<span class="tiny faint">{ c.T("support.field.kindHelp") }</span>
				</div>
				// One question per kind, and only the one that applies.
				//
				// The form used to ask everybody for a question category —
				// including somebody reporting a player, for whom it means
				// nothing — and asked nobody which player a report was about,
				// which is the one thing a report has to say. Each kind now
				// gets the field it needs and no others; with no JavaScript
				// every pane is visible and the server still only reads the one
				// that belongs to the chosen kind.
				<div class="field" data-ticket-pane={ models.TicketAbuse } x-data="ticketPane" x-show="shown" hidden?={ !models.TicketNeedsPlayer(d.Kind) }>
					<label class="label" for="reported">{ c.T("support.field.reported") }</label>
					<input
						class="input"
						id="reported"
						name="reported"
						type="text"
						list="support-people"
						value={ d.Reported }
						placeholder={ c.T("support.field.reportedPlaceholder") }
						autocomplete="off"
					/>
					<datalist id="support-people">
						for _, u := range d.Known {
							<option value={ u.Username }>{ u.DisplayName }</option>
						}
					</datalist>
					if e := d.Err("reported"); e != "" {
						@FieldError("reported", e)
					}
					<span class="tiny faint">{ c.T("support.field.reportedHelp") }</span>
				</div>
				<div class="field" data-ticket-pane={ models.TicketQuestion + " " + models.TicketSuggestion } x-data="ticketPane" x-show="shown" hidden?={ !models.TicketNeedsCategory(d.Kind) }>
					<label class="label" for="category">
						{ c.T("game.setup.category") }
						<span class="tiny faint">({ c.T("common.optional") })</span>
					</label>
					<select class="select" id="category" name="category">
						<option value="0">{ c.T("support.field.noCategory") }</option>
						for _, cat := range d.Categories {
							<option value={ fmt.Sprint(cat.ID) } selected?={ d.CategoryID == cat.ID }>
								{ cat.Name }
							</option>
						}
					</select>
					<span class="tiny faint">{ c.T("support.field.categoryHelp") }</span>
				</div>
				@TextField(c, TextFieldOpts{
					ID:          "subject",
					Name:        "subject",
					Label:       c.T("support.field.subject"),
					Value:       d.Subject,
					Placeholder: c.T("support.field.subjectPlaceholder"),
					MaxLength:   140,
					Required:    true,
					Error:       d.Err("subject"),
				})
				@TextAreaField(c, TextAreaOpts{
					ID:          "body",
					Name:        "body",
					Label:       c.T("support.field.body"),
					Value:       d.Body,
					Placeholder: c.T("support.field.bodyPlaceholder"),
					Rows:        7,
					MaxLength:   4000,
					Required:    true,
					Error:       d.Err("body"),
				})
				<div class="row gap-5">
					<button class="btn btn--primary" type="submit">{ c.T("support.send") }</button>
					<a class="btn btn--ghost" href="/support">{ c.T("common.cancel") }</a>
				</div>
			</form>
		</div>
	}
}

type SupportThreadData struct {
	Ticket   *models.Ticket
	Messages []*models.TicketMessage
}

templ SupportThread(c Ctx, d SupportThreadData) {
	@Base(c, d.Ticket.Subject) {
		// A staff reply lands here, not only in the badge.
		<div class="shell shell--narrow stack" data-live="support.reply">
			@BackLink(c, "/support", c.T("support.title"))
			<section class="card stack-sm">
				<div class="row row--between row--wrap gap-5">
					<div style="min-width:0">
						<h1 style="font-size:1.2rem">{ d.Ticket.Subject }</h1>
						<p class="tiny muted">
							{ c.T(models.TicketKindKey(d.Ticket.Kind)) } · { c.Tr.DateTime(d.Ticket.CreatedAt) }
						</p>
					</div>
					<span class={ "tag", statusTagClass(d.Ticket.Status) }>
						{ c.T(models.TicketStatusKey(d.Ticket.Status)) }
					</span>
				</div>
			</section>
			// Where this is and what happens next, in words. The status tag is
			// for triage — "waiting_user" tells staff something and tells the
			// person who asked nothing at all.
			<div class={ "ticket-stage", "ticket-stage--" + d.Ticket.Stage() }>
				<span class="ticket-stage__what bold">{ c.T(d.Ticket.StageKey()) }</span>
				<span class="ticket-stage__next small">{ c.T(d.Ticket.StageNextKey()) }</span>
			</div>
			@ticketThread(c, d.Messages, false)
			if d.Ticket.Status != models.TicketClosed {
				<form method="post" action={ templ.SafeURL("/support/" + d.Ticket.ID.String() + "/reply") } class="card stack-sm">
					<input type="hidden" name="csrf_token" value={ c.CSRF }/>
					<textarea
						class="textarea"
						name="body"
						rows="4"
						maxlength="4000"
						required
						placeholder={ c.T("support.replyPlaceholder") }
					></textarea>
					<div class="row" style="justify-content:flex-end">
						<button class="btn btn--primary" type="submit">{ c.T("messages.send") }</button>
					</div>
				</form>
				// Someone who solved their own problem can say so. Without this
				// the only way out was a reply that a moderator then had to read
				// and close by hand, with the queue badge lit until they did.
				<form
					method="post"
					action={ templ.SafeURL("/support/" + d.Ticket.ID.String() + "/close") }
					class="row"
					style="justify-content:flex-end"
					data-confirm={ c.T("support.closeConfirm") }
				>
					<input type="hidden" name="csrf_token" value={ c.CSRF }/>
					<button class="btn btn--ghost btn--sm" type="submit">{ c.T("support.close") }</button>
				</form>
			} else {
				// Closed is not a wall. The problem coming back is the most
				// likely reason somebody returns to a closed ticket, and making
				// them open a second one loses everything already said.
				<form
					method="post"
					action={ templ.SafeURL("/support/" + d.Ticket.ID.String() + "/reply") }
					class="card stack-sm"
				>
					<input type="hidden" name="csrf_token" value={ c.CSRF }/>
					<p class="small muted">{ c.T("support.closedNotice") }</p>
					<textarea
						class="textarea"
						name="body"
						rows="3"
						maxlength="4000"
						required
						placeholder={ c.T("support.reopenPlaceholder") }
					></textarea>
					<div class="row" style="justify-content:flex-end">
						<button class="btn btn--soft" type="submit">{ c.T("support.reopen") }</button>
					</div>
				</form>
			}
		</div>
	}
}

// ticketThread renders the conversation. staffView additionally shows the
// internal notes, which a player must never see.
templ ticketThread(c Ctx, messages []*models.TicketMessage, staffView bool) {
	<div class="stack-sm">
		for _, m := range messages {
			<article class={ "ticket-msg", ticketMsgClass(m) }>
				<div class="row row--between" style="gap:var(--s-4);margin-block-end:6px">
					<span class="tiny bold">
						if m.Internal {
							<span class="tag tag--warning tiny">{ c.T("support.internalNote") }</span>
						}
						if m.FromStaff() {
							{ c.T("support.staff") }
							if staffView && m.SenderName != "" {
								<span class="muted">{ " · " + m.SenderName }</span>
							}
						} else {
							{ m.SenderName }
						}
					</span>
					<span class="tiny faint">{ c.Tr.DateTime(m.CreatedAt) }</span>
				</div>
				<p class="small" style="white-space:pre-wrap">{ m.Body }</p>
			</article>
		}
	</div>
}

// ------------------------------------------------------------- staff side --

// TicketFilterState is the current filter selection, echoed back into the form.
type TicketFilterState struct {
	Query    string
	Kind     string
	Status   string
	Priority string
	Assignee string
	Waiting  bool
}

// QueryString is the filter as a query string, so opening a conversation keeps
// the queue it was opened from. Without it, answering a ticket from "awaiting
// reply" drops you back into every ticket there is.
func (f TicketFilterState) QueryString() string {
	v := url.Values{}
	for name, value := range map[string]string{
		"q": f.Query, "kind": f.Kind, "status": f.Status,
		"priority": f.Priority, "assignee": f.Assignee,
	} {
		if value != "" {
			v.Set(name, value)
		}
	}
	if f.Waiting {
		v.Set("waiting", "1")
	}
	if len(v) == 0 {
		return ""
	}
	return "?" + v.Encode()
}

type AdminSupportData struct {
	Tickets   []*models.Ticket
	Total     int
	Pager     Pager
	Counts    models.TicketCounts
	Breakdown map[string]int
	Staff     []*models.UserCard
	Filter    TicketFilterState
	// Open is the conversation showing beside the list, with its messages and
	// the canned replies for its language. Nil when nothing is open.
	Open     *models.Ticket
	Messages []*models.TicketMessage
	Canned   []*models.CannedReply
}

// Open is the conversation showing beside the list, nil when none is. The
// list and the thread are one screen: you work down a queue, and a thread on
// a page of its own loses the queue every time a reply is sent.
func (d AdminSupportData) HasOpen() bool { return d.Open != nil }

// Filtered reports whether anything is narrowing the inbox, which decides
// whether a way to clear it is offered.
func (d AdminSupportData) Filtered() bool {
	f := d.Filter
	return f.Query != "" || f.Kind != "" || f.Status != "" || f.Priority != "" ||
		f.Assignee != "" || f.Waiting
}

templ AdminSupport(c Ctx, a AdminChrome, d AdminSupportData) {
	@adminShell(c, a, c.T("admin.nav.support")) {
		<div data-live="support.new support.reply" hidden></div>
		@adminPageHead(c, c.T("admin.nav.support"), c.T("support.inbox.sub")) {
		}
		// Each tile is a link to the view it counts, not a number to read and
		// then go looking for.
		<div class="kpis">
			@supportTile(c, "i-inbox", c.T("support.stat.open"), c.T("support.stat.openMeta"),
				d.Counts.OpenTotal, "/admin/support?status=open", false)
			@supportTile(c, "i-clock", c.T("support.stat.awaiting"), c.T("support.stat.awaitingMeta"),
				d.Counts.AwaitingReply, "/admin/support?waiting=1", d.Counts.AwaitingReply > 0)
			@supportTile(c, "i-zap", c.T("support.stat.urgent"), c.T("support.stat.urgentMeta"),
				d.Counts.HighPriority, "/admin/support?priority=high", d.Counts.HighPriority > 0)
			@supportTile(c, "i-user", c.T("support.stat.mine"), c.T("support.stat.mineMeta"),
				d.Counts.AssignedToMe, "/admin/support?assignee=me", false)
		</div>
		<section class="panel">
			// The views staff actually work from, before they reach for the
			// detailed filter below.
			<div class="tabs" role="tablist">
				@supportTab(c, "/admin/support", c.T("support.filter.all"),
					d.Filter.Status == "" && !d.Filter.Waiting && d.Filter.Assignee == "", 0)
				@supportTab(c, "/admin/support?status=open", c.T("support.filter.open"),
					d.Filter.Status == "open", d.Counts.OpenTotal)
				@supportTab(c, "/admin/support?waiting=1", c.T("support.filter.awaiting"),
					d.Filter.Waiting, d.Counts.AwaitingReply)
				@supportTab(c, "/admin/support?assignee=me", c.T("support.filter.mine"),
					d.Filter.Assignee == "me", d.Counts.AssignedToMe)
				@supportTab(c, "/admin/support?status=closed", c.T("support.filter.closed"),
					d.Filter.Status == "closed", 0)
			</div>
			<form method="get" action="/admin/support">
				<div class="toolbar">
					<label class="input-icon">
						@adminIcon("i-search", "")
						<span class="sr-only">{ c.T("support.filter.searchPlaceholder") }</span>
						<input
							class="input input-sm"
							type="search"
							name="q"
							value={ d.Filter.Query }
							placeholder={ c.T("support.filter.searchPlaceholder") }
						/>
					</label>
					<select class="select input-sm" name="priority" aria-label={ c.T("support.filter.priority") }>
						<option value="">{ c.T("support.filter.anyPriority") }</option>
						for _, priority := range models.TicketPriorities {
							<option value={ priority } selected?={ d.Filter.Priority == priority }>
								{ c.T(models.TicketPriorityKey(priority)) }
							</option>
						}
					</select>
					<select class="select input-sm" name="assignee" aria-label={ c.T("support.filter.anyAssignee") }>
						<option value="">{ c.T("support.filter.anyAssignee") }</option>
						<option value="unassigned" selected?={ d.Filter.Assignee == "unassigned" }>
							{ c.T("support.filter.unassigned") }
						</option>
						<option value="me" selected?={ d.Filter.Assignee == "me" }>
							{ c.T("support.filter.mine") }
						</option>
						for _, member := range d.Staff {
							<option value={ member.ID.String() } selected?={ d.Filter.Assignee == member.ID.String() }>
								{ member.DisplayName }
							</option>
						}
					</select>
					<span class="spacer"></span>
					<button class="btn btn-sm btn-primary" type="submit">{ c.T("common.search") }</button>
					if d.Filtered() {
						<a class="btn btn-ghost btn-sm" href="/admin/support">
							@adminIcon("i-x", "icon-sm")
							{ c.T("admin.filters.clear") }
						</a>
					}
				</div>
			</form>
			// Topic chips carry live counts, so the shape of the queue is
			// visible before any filtering happens.
			<div class="toolbar" style="padding-block:10px">
				// The kit styles chip-row's buttons; these are links because the
				// count beside each topic is the server's and choosing one
				// navigates. admin-app.css gives a link in this row the same
				// face, and aria-current is its pressed state.
				<div class="chip-row" aria-label={ c.T("support.filter.topic") }>
					for _, kind := range models.TicketKinds {
						<a
							href={ templ.SafeURL("/admin/support?kind=" + kind) }
							if d.Filter.Kind == kind {
								aria-current="page"
							}
						>
							@adminIcon(ticketKindIcon(kind), "icon-sm")
							<span>{ c.T(models.TicketKindKey(kind)) }</span>
							<b class="n">{ fmt.Sprint(d.Breakdown[kind]) }</b>
						</a>
					}
				</div>
			</div>
			<div class={ "inbox", templ.KV("show-thread", d.HasOpen()) }>
				<div class="inbox-list">
					if len(d.Tickets) == 0 {
						@adminEmpty(c, "i-inbox", c.T("support.filter.empty"), c.T("support.filter.emptySub")) {
							if d.Filtered() {
								<a class="btn btn-sm" href="/admin/support">{ c.T("admin.filters.clear") }</a>
							}
						}
					} else {
						<div class="list">
							for _, t := range d.Tickets {
								@adminTicketRow(c, d, t, d.Open != nil && d.Open.ID == t.ID)
							}
						</div>
						@adminPager(c, d.Pager)
					}
				</div>
				if d.Open != nil {
					@ticketPane(c, d)
				} else {
					<div class="thread">
						@adminEmpty(c, "i-inbox", c.T("support.thread.none"), c.T("support.thread.noneSub"))
					</div>
				}
			</div>
		</section>
	}
}

// supportTile is one of the four counts above the inbox, as a link to the view
// it counts.
templ supportTile(c Ctx, icon, label, meta string, n int, href string, attention bool) {
	<div class={ "kpi", templ.KV("is-attention", attention && n > 0) }>
		<div class="kpi-label">
			@adminIcon(icon, "")
			{ label }
		</div>
		<div class="kpi-value">{ fmt.Sprint(n) }</div>
		<div class="kpi-meta">
			{ meta }
			// The whole tile is the link, not the number inside it: these are
			// four counts you open rather than four numbers you read.
			<a class="stretch" href={ templ.SafeURL(href) } aria-label={ label }></a>
		</div>
	</div>
}

templ supportTab(c Ctx, href, label string, on bool, count int) {
	<a
		class={ "tab", templ.KV("is-on", on) }
		href={ templ.SafeURL(href) }
		role="tab"
		aria-selected={ boolAttr(on) }
	>
		{ label }
		if count > 0 {
			<span class="n">{ fmt.Sprint(count) }</span>
		}
	</a>
}

templ adminTicketRow(c Ctx, d AdminSupportData, t *models.Ticket, open bool) {
	<a
		class={ "list-item", "ticket", templ.KV("is-unread", t.AwaitingStaff()), templ.KV("is-active", open) }
		href={ templ.SafeURL("/admin/support/" + t.ID.String() + d.Filter.QueryString()) }
		if open {
			aria-current="true"
		}
	>
		<span class="topic-ic sm" aria-hidden="true">
			@adminIcon(ticketKindIcon(t.Kind), "icon-sm")
		</span>
		<div class="grow" style="min-width:0">
			<div class="top">
				<span class="subj">{ t.Subject }</span>
				<span class="muted">{ c.Tr.RelativeTime(t.LastMessageAt) }</span>
			</div>
			<div class="prev">
				{ "@" + t.Username }
				{ " · " }
				{ c.T(models.TicketKindKey(t.Kind)) }
			</div>
			<div class="row" style="gap:6px;margin-top:6px;flex-wrap:wrap">
				<span class={ "badge", ticketStatusBadge(t.Status) }>
					{ c.T(models.TicketStatusKey(t.Status)) }
				</span>
				if t.Urgent() {
					<span class={ "badge", ticketPriorityBadge(t.Priority) }>
						{ c.T(models.TicketPriorityKey(t.Priority)) }
					</span>
				}
				if t.AssigneeUsername != "" {
					<span class="badge">{ "→ " + t.AssigneeUsername }</span>
				}
			</div>
		</div>
	</a>
}

// ticketPane is the conversation beside the list: who wrote it and about
// what, the four triage controls, the messages, and the box to answer in.
templ ticketPane(c Ctx, d AdminSupportData) {
	{{ t := d.Open }}
	<div class="thread">
		<div class="thread-head">
			// On a phone the two panes are one, and this is the way back to
			// the list — the kit hides it at every width where both are shown.
			<button class="icon-btn menu-back" type="button" data-back-to-list aria-label={ c.T("admin.nav.support") }>
				@adminIcon("i-chevron-left", "icon-flip")
			</button>
			<span class="topic-ic" aria-hidden="true">
				@adminIcon(ticketKindIcon(t.Kind), "")
			</span>
			<div class="grow" style="min-width:0">
				<h2 class="truncate">{ t.Subject }</h2>
				<p class="s truncate">
					<a href={ templ.SafeURL("/u/" + t.Username) }>{ "@" + t.Username }</a>
					{ " · " + c.T(models.TicketKindKey(t.Kind)) }
					{ " · " + c.Tr.DateTime(t.CreatedAt) }
					if device := describeDevice(t.UserAgent); device != "" {
						{ " · " + device }
					}
				</p>
			</div>
			// Resolving is the one verdict that ends a conversation, so it sits
			// apart from the four selects that merely describe it.
			if t.Status != models.TicketResolved && t.Status != models.TicketClosed {
				<form method="post" action={ templ.SafeURL("/admin/support/" + t.ID.String() + "/update") }>
					<input type="hidden" name="csrf_token" value={ c.CSRF }/>
					<input type="hidden" name="status" value={ models.TicketResolved }/>
					<button class="btn btn-sm" type="submit">
						@adminIcon("i-check", "icon-sm")
						{ c.T("support.thread.resolve") }
					</button>
				</form>
			}
		</div>
		// Triage submits on change, so staff never lose a click.
		<form
			class="ticket-meta"
			method="post"
			action={ templ.SafeURL("/admin/support/" + t.ID.String() + "/update") }
		>
			<input type="hidden" name="csrf_token" value={ c.CSRF }/>
			@ticketSelect(c, "status", c.T("support.filter.status"), models.TicketStatuses,
				t.Status, models.TicketStatusKey)
			@ticketSelect(c, "priority", c.T("support.filter.priority"), models.TicketPriorities,
				t.Priority, models.TicketPriorityKey)
			<div class="field">
				<label class="label" for="t-assignee">{ c.T("support.thread.assignee") }</label>
				<select class="select input-sm" id="t-assignee" name="assignee" onchange="this.form.submit()">
					<option value="unassigned" selected?={ t.AssignedTo == nil }>
						{ c.T("support.filter.unassigned") }
					</option>
					for _, member := range d.Staff {
						<option value={ member.ID.String() } selected?={ assignedTo(t, member.ID.String()) }>
							{ member.DisplayName }
						</option>
					}
				</select>
			</div>
			@ticketSelect(c, "kind", c.T("support.filter.topic"), models.TicketKinds,
				t.Kind, models.TicketKindKey)
			<noscript>
				<button class="btn btn-sm btn-primary" type="submit">{ c.T("common.save") }</button>
			</noscript>
		</form>
		<div class="thread-body">
			for _, m := range d.Messages {
				@ticketMessage(c, m)
			}
		</div>
		// Reply or internal note, as two tabs over one box: it is the same act
		// of writing on the ticket, and which one it is decides who can read it.
		<form
			class="composer"
			method="post"
			action={ templ.SafeURL("/admin/support/" + t.ID.String() + "/reply") }
			x-data="cannedReply"
		>
			<input type="hidden" name="csrf_token" value={ c.CSRF }/>
			<div class="tabs" role="tablist">
				<label class={ "tab", "is-on" } role="tab">
					<input class="sr-only" type="radio" name="internal" value="" checked/>
					{ c.T("support.thread.reply") }
				</label>
				<label class="tab" role="tab">
					<input class="sr-only" type="radio" name="internal" value="1"/>
					{ c.T("support.internalHelp") }
				</label>
			</div>
			if len(d.Canned) > 0 {
				<div class="chip-row" style="margin-top:10px">
					for _, reply := range d.Canned {
						<button type="button" data-canned={ reply.Body } x-on:click="paste">
							@adminIcon("i-text", "icon-sm")
							{ reply.Title }
						</button>
					}
				</div>
			}
			<textarea
				class="textarea"
				style="margin-top:10px"
				name="body"
				rows="4"
				maxlength="4000"
				required
				data-reply-box
				x-ref="box"
				placeholder={ c.T("support.replyPlaceholder") }
			></textarea>
			<div class="row">
				<span class="spacer"></span>
				<button class="btn" type="submit" name="resolve" value="1">
					@adminIcon("i-check-circle", "icon-sm")
					{ c.T("support.thread.sendResolve") }
				</button>
				<button class="btn btn-primary" type="submit">
					@adminIcon("i-send", "icon-sm")
					{ c.T("messages.send") }
				</button>
			</div>
		</form>
	</div>
}

// ticketSelect is one of the triage controls. The three that are a fixed list
// of states share this; the assignee is a list of people and has its own.
templ ticketSelect(c Ctx, name, label string, options []string, current string, key func(string) string) {
	<div class="field">
		<label class="label" for={ "t-" + name }>{ label }</label>
		<select class="select input-sm" id={ "t-" + name } name={ name } onchange="this.form.submit()">
			for _, option := range options {
				<option value={ option } selected?={ current == option }>{ c.T(key(option)) }</option>
			}
		</select>
	</div>
}

// ticketMessage is one turn of the conversation. Three shapes: what the player
// wrote, what staff sent back, and the note staff left for each other — which
// the player never sees and which therefore cannot look like a reply.
templ ticketMessage(c Ctx, m *models.TicketMessage) {
	<div class={ "msg", templ.KV("me", m.SenderRole == "staff" && !m.Internal), templ.KV("note", m.Internal) }>
		if m.SenderRole != "staff" || m.Internal {
			<span class="avatar sm" aria-hidden="true">{ Initial(m.SenderName) }</span>
		}
		<div style="min-width:0">
			<div class="bubble" dir={ ContentDir(c.Locale) }>
				if m.Internal {
					<b>{ c.T("support.internalNote") }</b>
					{ " " }
				}
				{ m.Body }
			</div>
			<div class="meta">
				{ m.SenderName }
				{ " · " }
				{ c.Tr.RelativeTime(m.CreatedAt) }
				if m.Internal {
					{ " · " + c.T("support.internalOnly") }
				}
			</div>
		</div>
	</div>
}

// ------------------------------------------------------------- Go helpers --

func ticketIcon(kind string) string {
	switch kind {
	case models.TicketSuggestion:
		return "💡"
	case models.TicketQuestion:
		return "❓"
	case models.TicketBug:
		return "🐞"
	case models.TicketAccount:
		return "🔑"
	case models.TicketAbuse:
		return "🚩"
	default:
		return "💬"
	}
}

func statusTagClass(status string) string {
	switch status {
	case models.TicketOpen:
		return "tag--warning"
	case models.TicketInProgress:
		return "tag--info"
	case models.TicketWaitingUser:
		return "tag--accent"
	case models.TicketResolved:
		return "tag--success"
	default:
		return ""
	}
}

func priorityTagClass(priority string) string {
	switch priority {
	case models.PriorityUrgent:
		return "tag--danger"
	case models.PriorityHigh:
		return "tag--warning"
	default:
		return ""
	}
}

func ticketMsgClass(m *models.TicketMessage) string {
	switch {
	case m.Internal:
		return "ticket-msg--note"
	case m.FromStaff():
		return "ticket-msg--staff"
	default:
		return "ticket-msg--user"
	}
}

func assignedTo(t *models.Ticket, id string) bool {
	return t.AssignedTo != nil && t.AssignedTo.String() == id
}
