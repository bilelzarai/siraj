.env
tmp/
bin/
web/dist/
!web/dist/.gitkeep
node_modules/
*.exe
*.test
*.out
.DS_Store

# Binaries and runtime state: scripts/app.sh builds into tmp/, the Docker image into
# /out, and neither belongs in the repo. `server`, `devseed` and `server.pid` were
# tracked by accident — 41 MB of build output in a source tree.
/server
/worker
/devseed
/server.pid
*.pid
*.log

# Runtime data the app writes: UPLOADS_DIR (./var/uploads) and the generated
# api-docs.html. Content, not source.
/var/
